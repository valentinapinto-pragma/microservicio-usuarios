          "item": [
            {
              "name": "1.1 Crear Propietario - Exitoso (201 Created)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('Código de respuesta debe ser 201 Created', function () {",
                      "    pm.response.to.have.status(201);",
                      "});"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Valentina\",\n  \"lastName\": \"Pinto\",\n  \"identityDocument\": \"1002345678\",\n  \"phoneNumber\": \"+573001234567\",\n  \"birthDate\": \"1998-05-15\",\n  \"email\": \"valentina.owner@correo.com\",\n  \"password\": \"PasswordSeguro123\"\n}"
